\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{}{Where $\mathcal  {L}$ and $\mathcal  {K}$ come from}}{42}{section*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces The passage from Ching's windows to the levelled ones. Both legs are continuous; the panels are snapshots, with $w=\tfrac  34$ an arbitrary sample. The top window's floor is $\max (x,c)$, so it sits at the vertex until $c$ overtakes it. Leg $1$ raises that floor to $\tfrac  12$; leg $2$ lowers the bottom ceiling from $1$ to $\tfrac  12$, at which point the windows abut. The middle panel is the common value $H^{(1)}_{1/2} = H^{(2)}_{1}$. The panel at right is not a stage of the path but the family the axioms forbid.}}{43}{figure.4}\protected@file@percent }
\newlabel{fig:legs}{{B.4}{43}{The passage from Ching's windows to the levelled ones. Both legs are continuous; the panels are snapshots, with $w=\tfrac 34$ an arbitrary sample. The top window's floor is $\max (x,c)$, so it sits at the vertex until $c$ overtakes it. Leg $1$ raises that floor to $\tfrac 12$; leg $2$ lowers the bottom ceiling from $1$ to $\tfrac 12$, at which point the windows abut. The middle panel is the common value $H^{(1)}_{1/2} = H^{(2)}_{1}$. The panel at right is not a stage of the path but the family the axioms forbid}{figure.4}{}}
\newlabel{eq:leg1-3}{{29}{43}{Where \texorpdfstring {$\Lop $ and $\Kop $}{L and K} come from}{equation.B.29}{}}
\newlabel{eq:leg2-3}{{30}{43}{Where \texorpdfstring {$\Lop $ and $\Kop $}{L and K} come from}{equation.B.30}{}}
